<Window x:Class="AIPulse.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIPulse"
        Title="AI Pulse · miaomiao tools" Width="1400" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Icon="app.ico" Style="{StaticResource {x:Type Window}}">
  <Grid Background="#F3F6F9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#152A35">
      <Grid Margin="18,29,18,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,34">
          <StackPanel Orientation="Horizontal">
            <Border Background="#B3F0CD" Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#16372D" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="AI Pulse" FontSize="21" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="你的 AI 网络观察站" Foreground="#A8BCC9" Margin="0,15,0,0" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作空间" Foreground="#8EA6B4" Margin="16,5,0,12" FontSize="11"/>
          <Button x:Name="DashboardNav" Click="DashboardClick" Style="{StaticResource Nav}" Background="#28434D" Foreground="#C2F6D9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="连通面板"/></StackPanel></Button>
          <Button x:Name="HistoryNav" Click="HistoryClick" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="历史记录"/></StackPanel></Button>
          <Button Click="SettingsClick" Style="{StaticResource Nav}" IsEnabled="{Binding Idle}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="检测设置"/></StackPanel></Button>
          <Button x:Name="MiniModeButton" Click="MiniClick" Style="{StaticResource Nav}" ToolTip="适合挂在副屏的小窗口 · Ctrl+M"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="迷你模式"/></StackPanel></Button>
          <Border Background="#203944" CornerRadius="10" Padding="14" Margin="0,35,0,0">
            <StackPanel><TextBlock Text="当前检测线路" FontSize="11" Foreground="#AFC2CD"/><TextBlock Text="{Binding RouteName}" Foreground="White" Margin="0,9,0,7" FontWeight="SemiBold"/><TextBlock Text="{Binding RouteHelp}" Foreground="#AEC2CE" FontSize="11" TextWrapping="Wrap" LineHeight="19"/></StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="10,0,4,0">
          <TextBlock Text="本地运行 · 无需 API Key" Foreground="#B8CDD7" FontSize="11"/>
          <TextBlock Text="AI Pulse  1.2 · 轻量巡检" Foreground="#8FA8B8" FontSize="11" Margin="0,7,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="AI 连通性" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="轻量看连接，按需查响应。" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="导出报告" Click="ExportClick" Margin="0,0,10,0"/>
          <Button Content="检查 HTTP" Click="HttpClick" IsEnabled="{Binding CanHttp}" Margin="0,0,10,0" ToolTip="仅检查选中服务一次；同一域名至少间隔 10 分钟。自动巡检不会调用此项。"/>
          <Button x:Name="RunButton" Content="{Binding RunLabel}" Click="RunClick" Style="{StaticResource Primary}" MinWidth="130" ToolTip="快捷键 F5：开始或停止检测"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{Binding OverallBackground}" CornerRadius="10" Padding="18,13" Margin="0,0,0,18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{Binding Banner}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding OverallColor}"/><TextBlock Text="{Binding Subline}" Foreground="#526676" FontSize="12" Margin="0,5,18,0" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox Content="自动轻量巡检" IsChecked="{Binding Auto}"/><TextBlock Text="{Binding Countdown}" FontSize="11" Foreground="#586B7B" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="MetricsPanel" Grid.Row="2" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,13"><StackPanel><TextBlock Text="{Binding ScopeLabel}" Style="{StaticResource MutedText}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ReachedMetric}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="项" Foreground="{StaticResource Muted}" Margin="8,13,0,0"/></StackPanel></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,13"><StackPanel><TextBlock Text="需要关注" Style="{StaticResource MutedText}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AttentionMetric}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding OverallColor}"/><TextBlock Text="项" Foreground="{StaticResource Muted}" Margin="8,13,0,0"/></StackPanel></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,13"><StackPanel><TextBlock Text="{Binding LatencyLabel}" Style="{StaticResource MutedText}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding LatencyMetric}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="ms" Foreground="{StaticResource Muted}" Margin="8,13,0,0"/></StackPanel></StackPanel></Border>
        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,13"><StackPanel><TextBlock Text="已记录检测" Style="{StaticResource MutedText}" FontSize="12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RoundMetric}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="轮" Foreground="{StaticResource Muted}" Margin="8,13,0,0"/></StackPanel></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="3" x:Name="DashboardPage">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="490"/><ColumnDefinition Width="20"/><ColumnDefinition x:Name="DetailColumn" Width="300"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="20,16,16,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="服务状态" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
              <Grid Grid.Column="1" Margin="0,0,10,0"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索服务" ToolTip="按服务名称或域名筛选" Padding="29,8,8,8"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索服务" Foreground="#778794" VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <CheckBox Grid.Column="2" Content="只看需关注" IsChecked="{Binding OnlyIssues}" FontSize="12"/>
            </Grid>
            <Grid Grid.Row="2" Background="#F7F9FB" Margin="1,0,1,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="76"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="服务 / 检测地址" Foreground="{StaticResource Muted}" FontSize="11" Margin="20,10,0,10"/><TextBlock Grid.Column="1" Text="当前状态" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="耗时 ms" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="最近 20 轮" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid>
            <ListBox x:Name="ServiceList" Grid.Row="3" ItemsSource="{Binding Services}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="AI 服务检测列表">
              <ListBox.ItemTemplate><DataTemplate><Grid Height="61" ToolTip="{Binding Note}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="76"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid Margin="18,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" Background="{Binding Accent}" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Mark}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Host}" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><Border Background="{Binding StateBackground}" CornerRadius="5" HorizontalAlignment="Left" Padding="7,4"><TextBlock Text="{Binding Label}" Foreground="{Binding StateColor}" FontSize="11"/></Border><TextBlock Text="{Binding Http}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="2,4,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Latency}" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <local:HistoryStrip Grid.Column="3" Items="{Binding History}" Width="88" Height="19" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="暂无匹配结果，可调整搜索或关闭「只看需关注」。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ServiceList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="18,12"><StackPanel><ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Foreground="{StaticResource Accent}" Background="#E8EEF2" BorderThickness="0"/><TextBlock Text="绿：连接 / 响应   蓝：需认证   黄：需关注   灰：暂停   红：异常" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,2,0">
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="链路趋势" Style="{StaticResource Heading}"/><TextBlock Text="{Binding ChartCaption}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,8"/><local:TrendChart Items="{Binding ChartRounds}" Height="132"/><TextBlock Text="按检测范围分别绘图；暂停不算失败，红点表示本轮没有成功结果。" Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="这次怎么判断" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Diagnosis}" Style="{StaticResource MutedText}" Margin="0,10,0,14" FontSize="12"/><Border Height="1" Background="{StaticResource Line}"/><TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="{Binding SelectedDetails}" Style="{StaticResource MutedText}" FontSize="11.5"/><Button Content="复制本轮摘要" Click="CopyClick" HorizontalAlignment="Left" Margin="0,15,0,0" FontSize="12"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="本机与网关" Style="{StaticResource Heading}"/><TextBlock Text="网关地址" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,4"/><TextBlock Text="{Binding Network.Gateways, TargetNullValue=检测后显示}" TextWrapping="Wrap"/><TextBlock Text="网关响应" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/><TextBlock Text="{Binding Network.GatewayPing, TargetNullValue=检测后显示}" TextWrapping="Wrap"/><TextBlock Text="DNS 服务器" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/><TextBlock Text="{Binding Network.DnsServers, TargetNullValue=检测后显示}" TextWrapping="Wrap"/><TextBlock Text="{Binding Network.Baseline}" FontWeight="SemiBold" Margin="0,14,0,6" TextWrapping="Wrap"/><TextBlock Text="{Binding Network.ProxySummary}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Network.Detail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="3" x:Name="HistoryPage" Style="{StaticResource Card}" Visibility="Collapsed">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="历史记录" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="最近 240 轮保存在本机，区分轻量与 HTTP。双击查看详情；清空历史不会清除冷却。" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="清空历史" Click="ClearClick" IsEnabled="{Binding Idle}"/></Grid>
          <ListBox Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding Rounds}" BorderThickness="0" Background="Transparent" MouseDoubleClick="HistoryDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,16"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBlock Grid.Column="2" Text="{Binding Route}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="#89600D" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding LastCheck}" Foreground="{StaticResource Muted}" FontSize="11" Margin="18,0,0,0"/></Grid>
    </Grid>
  </Grid>
</Window>
