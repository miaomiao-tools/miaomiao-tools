<Window x:Class="AIPulse.MiniWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="AI Pulse · 迷你面板 · miaomiao tools" Width="400" Height="680" MinWidth="340" MinHeight="460"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Icon="app.ico"
 Style="{StaticResource {x:Type Window}}" Background="#101F27" Foreground="#EDF4F7" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="MiniMuted" Color="#ADBBC5"/>
  <SolidColorBrush x:Key="MiniLine" Color="#2A414D"/>
  <Style x:Key="MiniButton" TargetType="Button">
   <Setter Property="Background" Value="#1A303B"/><Setter Property="Foreground" Value="#D9E7EC"/><Setter Property="BorderBrush" Value="{StaticResource MiniLine}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#90E5C3"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#90E5C3"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MiniToggle" TargetType="ToggleButton">
   <Setter Property="Background" Value="#1A303B"/><Setter Property="Foreground" Value="#D9E7EC"/><Setter Property="MinHeight" Value="44"/><Setter Property="MinWidth" Value="44"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource MiniLine}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#26493F"/><Setter Property="Foreground" Value="#B3F0D7"/><Setter TargetName="Surface" Property="BorderBrush" Value="#579D82"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#90E5C3"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#90E5C3"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#213844"/><Setter Property="Foreground" Value="#EDF4F7"/><Setter Property="BorderBrush" Value="#43616E"/><Setter Property="Padding" Value="12"/><Setter Property="MaxWidth" Value="360"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="1,2">
    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="#4B6573" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#8BB5A9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="#101F27" BorderBrush="#34505E" BorderThickness="1" CornerRadius="16" Padding="16,12,16,14">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Height="44">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" CornerRadius="9" Background="#B3F0CD" Margin="0,0,9,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#183B30" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="AI Pulse" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="迷你面板" FontSize="11" Foreground="{StaticResource MiniMuted}" Margin="0,2,0,0"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <ToggleButton x:Name="PinButton" Style="{StaticResource MiniToggle}" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" ToolTip="置顶 / 取消置顶 · Ctrl+T" AutomationProperties.Name="窗口置顶" Padding="0" Width="44"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></ToggleButton>
     <Button x:Name="ExpandButton" Style="{StaticResource MiniButton}" Click="ExpandClick" ToolTip="展开完整面板 · Ctrl+M" AutomationProperties.Name="展开完整面板" Margin="5,0,0,0" Width="44" Padding="0"><TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button>
     <Button Style="{StaticResource MiniButton}" Click="CloseClick" ToolTip="退出 AI Pulse，停止巡检" AutomationProperties.Name="退出 AI Pulse" Width="44" Margin="5,0,0,0" Padding="0"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Button>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#19332F" BorderBrush="#31564A" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,14,0,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Scope}" FontSize="11.5" Foreground="#BAD1C7"/><TextBlock Text="{Binding Count}" Foreground="{Binding Accent}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,1,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Fill="{Binding Accent}" Width="5" Height="5" Margin="0,0,6,0"/><TextBlock Text="{Binding Headline}" Foreground="{Binding Accent}" FontSize="12"/></StackPanel><TextBlock Text="{Binding Meta}" Foreground="#BAD1C7" FontSize="11" Margin="0,8,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="服务连接" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Route}" FontSize="11" Foreground="{StaticResource MiniMuted}"/></Grid>
   <ListBox Grid.Row="3" x:Name="ServiceList" ItemsSource="{Binding Services}" SelectedItem="{Binding Model.Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="ServiceDoubleClick" AutomationProperties.Name="迷你面板服务状态">
    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="2,0,2,6"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#EDF4F7"/><Setter Property="AutomationProperties.Name" Value="{Binding MiniAccessibleName}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#192C36" BorderBrush="#293F4B" BorderThickness="1" CornerRadius="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#223C46"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#83C8AD"/><Setter TargetName="Tile" Property="Background" Value="#1D393B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#B3F0D7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="9,6" ToolTip="{Binding MiniTooltip}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MiniName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Ellipse Grid.Column="1" Fill="{Binding MiniColor}" Width="5" Height="5" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding MiniStatus}" Foreground="{Binding MiniColor}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="4" Margin="2,6,2,12" ToolTip="{Binding DetailTooltip}"><TextBlock Text="{Binding DetailTitle}" Foreground="#E0EAEE" FontSize="11.5" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource MiniMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Row="5">
    <ProgressBar Value="{Binding Model.Progress, Mode=OneWay}" Maximum="100" Height="2" BorderThickness="0" Foreground="#90E5C3" Background="#2A414D" Margin="0,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
     <Button x:Name="RunButton" Content="{Binding Model.RunLabel}" Click="RunClick" Style="{StaticResource MiniButton}" Background="#B3F0CD" Foreground="#14352A" FontWeight="SemiBold" BorderBrush="#B3F0CD" ToolTip="F5：轻量检测 / 停止"/>
     <ToggleButton Grid.Column="2" x:Name="AutoButton" Style="{StaticResource MiniToggle}" Content="自动巡检" IsChecked="{Binding Model.Auto, Mode=TwoWay}" ToolTip="仅 TCP / TLS 轻量巡检，至少间隔 5 分钟"/>
    </Grid>
    <Grid Margin="2,10,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Model.Countdown}" FontSize="10.5" Foreground="{StaticResource MiniMuted}"/><TextBlock Grid.Column="1" Text="{Binding Recent}" FontSize="10.5" Foreground="{StaticResource MiniMuted}"/></Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
